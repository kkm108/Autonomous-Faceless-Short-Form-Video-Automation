{
  "name": "faceless_short",
  "description": "Generate a faceless short-form video (YouTube Short) from a seed topic and publish it.",
  "seed_vars": ["topic"],
  "stages": [
    {
      "id": "script",
      "adapter": "scripting.generic_llm",
      "inputs": {
        "topic": "seed.topic"
      },
      "outputs": {
        "script": "script.json"
      }
    },
    {
      "id": "assets",
      "adapter": "assets.perchance_images",
      "inputs": {
        "script": "script.json",
        "image_count": 6
      },
      "outputs": {
        "images": "assets"
      }
    },
    {
      "id": "voiceover",
      "adapter": "tts.kokoro_tts",
      "inputs": {
        "script": "script.json"
      },
      "outputs": {
        "audio": "voiceover.wav",
        "word_timings": "word_timings.json"
      }
    },
    {
      "id": "assemble",
      "adapter": "assembly.ffmpeg",
      "inputs": {
        "script": "script.json",
        "images": "assets",
        "audio": "voiceover.audio",
        "timings": "voiceover.word_timings",
        "video": "final.mp4"
      },
      "outputs": {
        "video": "final.mp4",
        "captions": "captions.json",
        "subtitle_vtt": "captions.vtt",
        "subtitle_srt": "captions.srt",
        "thumbnail": "thumbnail.jpg",
        "metadata": "metadata.json"
      }
    },
    {
      "id": "publish",
      "adapter": "publish.youtube_studio",
      "inputs": {
        "video": "final.mp4",
        "script": "script.json",
        "thumbnail": "assemble.thumbnail",
        "metadata": "assemble.metadata"
      },
      "outputs": {
        "post_url": "post_url.json"
      }
    }
  ]
}
